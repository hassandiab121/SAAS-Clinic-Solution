<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" id="WebApp_ID" version="3.1">
  <display-name>JspApp</display-name>
  
<context-param>
	<param-name>DB_URL</param-name>
    <param-value>jdbc:mysql://localhost:3306/patient_data</param-value>  
</context-param>
 
 <context-param>
	<param-name>DB_Username</param-name>
    <param-value>root</param-value>  
</context-param>
  
  <context-param>
	<param-name>DB_Password</param-name>
    <param-value>123456</param-value>  
</context-param>

 <welcome-file-list>
  <welcome-file>queue</welcome-file>
  </welcome-file-list>
  
  <servlet>
	  <servlet-name>list</servlet-name>
	  <jsp-file>/WEB-INF/view/index.jsp</jsp-file>
  </servlet>
  
  <servlet>
	  <servlet-name>doctor</servlet-name>
	  <jsp-file>/WEB-INF/view/doctor.jsp</jsp-file>
  </servlet>
  
  <servlet>
	  <servlet-name>login</servlet-name>
	  <jsp-file>/WEB-INF/view/login.jsp</jsp-file>
  </servlet>
  
  <servlet>
    <servlet-name>queue</servlet-name>
    <servlet-class>queue.queue</servlet-class>
</servlet>

  <servlet-mapping>
  <servlet-name>default</servlet-name>
  <url-pattern>/CSS/*</url-pattern>
</servlet-mapping>

<servlet-mapping>
  <servlet-name>default</servlet-name>
  <url-pattern>/JS/*</url-pattern>
</servlet-mapping>

</web-app>